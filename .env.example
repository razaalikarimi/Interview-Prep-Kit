# ============================================================
# ENVIRONMENT VARIABLES — COPY TO .env AND FILL IN VALUES
# ============================================================

# Application environment
NODE_ENV=development

# API Server
PORT=3001

# MongoDB connection string
# For local dev: mongodb://localhost:27017/interview-prep
# For production: mongodb+srv://user:pass@cluster.mongodb.net/interview-prep
MONGODB_URI=mongodb://localhost:27017/interview-prep

# Session secret (use a long random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-secret-here-change-in-production

# ============================================================
# LLM CONFIGURATION
# ============================================================

# LLM Provider (currently supported: gemini)
LLM_PROVIDER=gemini

# LLM Model name
# Gemini: gemini-1.5-flash (free tier), gemini-1.5-pro (paid)
LLM_MODEL=gemini-1.5-flash

# LLM API Key
# Gemini: Get from https://ai.google.dev/
LLM_API_KEY=your-gemini-api-key-here

# Maximum concurrent LLM requests (free tier: 1-2 recommended)
LLM_MAX_CONCURRENCY=2

# ============================================================
# FRONTEND
# ============================================================

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Backend URL (for frontend API calls)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================================
# CRAWLER CONFIGURATION
# ============================================================

# Maximum pages to crawl per company (default: 15)
CRAWLER_MAX_PAGES=15

# Request timeout in milliseconds (default: 10000)
CRAWLER_TIMEOUT_MS=10000

# Maximum response size in bytes (default: 2097152 = 2MB)
CRAWLER_MAX_RESPONSE_BYTES=2097152

# Concurrent crawler requests (default: 2)
CRAWLER_CONCURRENCY=2

# Rate limit between crawler requests in ms (default: 500)
CRAWLER_RATE_LIMIT_MS=500

# ============================================================
# SSRF PROTECTION
# ============================================================
# IMPORTANT: SSRF_ALLOW_HOSTS is for EVALUATION/DEVELOPMENT ONLY.
# In production, leave this EMPTY to block all private IPs.
#
# For batch evaluation with localhost test servers:
# SSRF_ALLOW_HOSTS=localhost,127.0.0.1
#
# Never set this in production.
SSRF_ALLOW_HOSTS=

# ============================================================
# EVALUATION MODE
# ============================================================
# Set to 'true' when running the batch evaluator.
# This enables localhost URL support and disables some production checks.
# NEVER set to 'true' in production.
EVAL_MODE=false
