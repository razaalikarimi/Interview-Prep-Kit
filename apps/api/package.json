{
  "name": "@interview-prep/api",
  "version": "1.0.0",
  "private": true,
  "main": "api/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node -e \"const fs=require('fs'),path=require('path'); const d=path.resolve('node_modules/@interview-prep/shared'); const s=path.resolve('../../packages/shared'); if(fs.existsSync(s)){fs.mkdirSync(path.dirname(d),{recursive:true}); try{fs.cpSync(s,d,{recursive:true})}catch(e){}}\"",
    "build": "tsup",
    "start": "node api/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",

    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@interview-prep/shared": "file:../../packages/shared",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "robots-parser": "^3.0.1",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "uuid": "^10.0.0",
    "winston": "^3.15.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
